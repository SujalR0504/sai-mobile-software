# ==============================================================================
# MOBILE SHOP ERP & POS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure values as needed for your deployment:
# cp .env.example .env
# ==============================================================================

# Server & Network Settings
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Database Settings
# Path to the embedded SQLite database file (relative to project root or absolute)
DATABASE_PATH=data/store.sqlite

# MongoDB Atlas Cloud Database Configuration
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/mobile_shop_erp?retryWrites=true&w=majority"
MONGODB_DB_NAME="mobile_shop_erp"
MONGODB_AUTO_SYNC=true

# Security & Authentication
JWT_SECRET=replace-with-a-secure-random-secret-key
CORS_ORIGIN=*

# Store / Business Profile Defaults (Available in Vite frontend via VITE_ prefix)
VITE_APP_TITLE="Mobile Shop ERP & POS"
VITE_SHOP_NAME="Shri Sai Mobile"
VITE_OWNER_NAME="Store Owner"
VITE_SHOP_PHONE="9826011223"
VITE_SHOP_ADDRESS="Main Market, Harda"
VITE_SHOP_CITY="Harda"
VITE_SHOP_STATE="Madhya Pradesh"
VITE_SHOP_STATE_CODE="23"
VITE_DEFAULT_CURRENCY="INR"

# Invoice & Document Numbering Prefixes
VITE_ORDER_PREFIX="ORD-"
VITE_GST_PREFIX="GST/2026-27/"
VITE_NONGST_PREFIX="NG/2026-27/"
VITE_PURCHASE_PREFIX="PUR/2026-27/"

# Customer Messaging & WhatsApp Integration
VITE_WHATSAPP_PHONE="919826011223"
VITE_WHATSAPP_ENABLED=true
